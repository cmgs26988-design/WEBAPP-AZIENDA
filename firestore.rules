rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzioni helper per la sicurezza del database di TEST
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Qui il SuperAdmin sei TU con la tua mail di test
    function isIoSviluppatore() {
      return isSignedIn() && request.auth.token.email == 'cmgs26988@gmail.com';
    }

    // 1. UTENTI AUTORIZZATI (Admin)
    match /utenti_autorizzati/{docId} {
      allow get: if true; 
      allow list, write: if isIoSviluppatore();
    }

    // 2. WORKERS (I codici d'accesso dei dipendenti)
    match /workers/{workerId} {
      allow read, write: if true; // <--- Cambiala così!
    }

    // 3. TIME ENTRIES (Registrazioni ore storiche)
    match /timeEntries/{entryId} {
      allow read, create: if true; 
      allow update, delete: if isIoSviluppatore(); 
    }
    
    // 4. CLOCK EVENTS (Timbrature ingresso/uscita in tempo reale)
    match /clockEvents/{eventId} {
      allow read, create: if true;
      allow update, delete: if isIoSviluppatore();
    }

    // 5. MATERIAL REQUESTS (Richieste materiali)
    match /materialRequests/{requestId} {
      allow read, create: if true; 
      allow update: if isIoSviluppatore() || (resource.data.status == 'draft'); 
      allow delete: if isIoSviluppatore(); 
    }

    // 6. FEEDBACK (Segnalazioni e migliorie dall'app)
    match /feedback/{feedbackId} {
      allow create: if true; // Chiunque dall'app può inviare un feedback
      allow read, update, delete: if isIoSviluppatore(); // Solo tu puoi vederli nel pannello privato
    }

    // Protezione globale di sicurezza per tutto il resto
    match /{document=**} {
      allow read, write: if isIoSviluppatore();
    }
  }
}
