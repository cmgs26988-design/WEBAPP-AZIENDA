rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'cmgs26988@gmail.com' ||
        request.auth.token.email == 'admin@optime-rdm.com'
      );
    }

    function adminHasAzienda(aziendaId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/utenti_autorizzati/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/utenti_autorizzati/$(request.auth.token.email)).data.azienda_id == aziendaId
      );
    }

    // UTENTI AUTORIZZATI - Accessibile per il controllo admin
    match /utenti_autorizzati/{docId} {
      allow get: if true; 
      allow list: if isSignedIn() && (resource == null || resource.data.email == request.auth.token.email);
      allow write: if isSuperAdmin();
    }

    // WORKERS - Permette il login tramite codice identificativo e gestione admin
    match /workers/{workerId} {
      allow get: if true; 
      allow list: if isSignedIn() && (isSuperAdmin() || adminHasAzienda(resource.data.azienda_id));
      allow create: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(request.resource.data.azienda_id));
      allow update: if isSuperAdmin() || 
                    (isSignedIn() && adminHasAzienda(resource.data.azienda_id)) ||
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId']) && (resource.data.deviceId == '' || resource.data.deviceId == null));
      allow delete: if isSuperAdmin();
    }

    // TIME ENTRIES - Registrazioni ore
    match /timeEntries/{entryId} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // CLOCK EVENTS - Timbrature
    match /clockEvents/{eventId} {
      allow read, create: if true; 
      allow update, delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // MATERIAL REQUESTS - Richieste materiali
    match /materialRequests/{requestId} {
      allow read, create: if true; 
      allow update: if isSuperAdmin() || 
                    (isSignedIn() && adminHasAzienda(resource.data.azienda_id)) ||
                    (resource.data.status == 'draft');
      allow delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // FEEDBACK - Segnalazioni bug e migliorie
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    // COMPANIES - Gestione aziende
    match /companies/{aziendaId} {
      allow get: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Global Deny per tutto il resto (sicurezza)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
