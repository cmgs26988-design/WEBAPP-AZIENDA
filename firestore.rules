rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserEmail() {
      return request.auth != null && request.auth.token != null && 'email' in request.auth.token ? request.auth.token.email : null;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && getUserEmail() != null && (
        getUserEmail() == 'cmgs26988@gmail.com' ||
        getUserEmail() == 'admin@optime-rdm.com'
      );
    }

    function adminHasAzienda(aziendaId) {
      return isSignedIn() && 
             getUserEmail() != null && 
             exists(/databases/$(database)/documents/utenti_autorizzati/$(getUserEmail())) &&
             get(/databases/$(database)/documents/utenti_autorizzati/$(getUserEmail())).data.azienda_id == aziendaId;
    }

    // WORKERS - Accessibile pubblicamente per login operaio
    match /workers/{workerId} {
      allow get, list: if true; 
      allow update: if true; 
      allow create: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(request.resource.data.azienda_id));
      allow delete: if isSuperAdmin();
    }

    // UTENTI AUTORIZZATI - Accessibile per il controllo admin (lettura pubblica per verifica iniziale)
    match /utenti_autorizzati/{docId} {
      allow get, list: if true; 
      allow write: if isSuperAdmin();
    }
    
    // TEST - Per verifica connessione
    match /test/{docId} {
      allow read: if true;
    }

    // TIME ENTRIES - Registrazioni ore
    match /timeEntries/{entryId} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // CLOCK EVENTS - Timbrature
    match /clockEvents/{eventId} {
      allow read, create: if true; 
      allow update, delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // MATERIAL REQUESTS - Richieste materiali
    match /materialRequests/{requestId} {
      allow read, create: if true; 
      allow update: if isSuperAdmin() || 
                    (isSignedIn() && adminHasAzienda(resource.data.azienda_id)) ||
                    (resource.data.status == 'draft');
      allow delete: if isSuperAdmin() || (isSignedIn() && adminHasAzienda(resource.data.azienda_id));
    }

    // FEEDBACK - Segnalazioni bug e migliorie
    match /feedback/{feedbackId} {
      allow create, read: if true;
      allow update, delete: if isSuperAdmin();
    }

    // COMPANIES - Gestione aziende
    match /companies/{aziendaId} {
      allow get: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Global Deny per tutto il resto (sicurezza)
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
