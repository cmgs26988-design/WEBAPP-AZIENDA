{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Represents a staff member/worker in the system.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "azienda_id": { "type": "string" },
        "photoUrl": { "type": "string" },
        "deviceId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "azienda_id"]
    },
    "TimeEntry": {
      "title": "Time Entry",
      "description": "Records hours worked by a worker on a specific site.",
      "type": "object",
      "properties": {
        "workerCode": { "type": "string" },
        "workerName": { "type": "string" },
        "azienda_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "cantiere": { "type": "string" },
        "intervento": { "type": "string" },
        "ordinaria": { "type": "number" },
        "straordinaria": { "type": "number" },
        "viaggio": { "type": "number" },
        "ferie": { "type": "number" },
        "notes": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workerCode", "date", "cantiere", "azienda_id"]
    },
    "MaterialRequest": {
      "title": "Material Request",
      "description": "Order for materials sent by a worker.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "workerName": { "type": "string" },
        "azienda_id": { "type": "string" },
        "cantiere": { "type": "string" },
        "intervento": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "items": { "type": "array" },
        "status": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["workerId", "cantiere", "items", "azienda_id"]
    },
    "ClockEvent": {
      "title": "Clock Event",
      "description": "Entrance or exit clock event.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "azienda_id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "timestamp": { "type": "object" },
        "type": { "type": "string", "enum": ["ENTRATA", "USCITA"] },
        "location": { "type": "object" }
      },
      "required": ["workerId", "type", "timestamp", "azienda_id"]
    },
    "AuthorizedUser": {
      "title": "Authorized User",
      "description": "User authorized to access the admin panel.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "azienda_id": { "type": "string" },
        "ruolo": { "type": "string" },
        "createdAt": { "type": "object" }
      },
      "required": ["email", "azienda_id", "ruolo"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback, bug reports or improvements.",
      "type": "object",
      "properties": {
        "tipo": { "type": "string", "enum": ["Bug/Errore", "Miglioria"] },
        "titolo": { "type": "string" },
        "descrizione": { "type": "string" },
        "priorita": { "type": "string", "enum": ["Alta", "Media", "Bassa"] },
        "status": { "type": "string", "enum": ["Aperto", "Risolto"] },
        "user": { "type": "string" },
        "azienda_id": { "type": "string" },
        "createdAt": { "type": "object" },
        "updatedAt": { "type": "object" }
      },
      "required": ["tipo", "titolo", "descrizione", "priorita", "status", "user", "azienda_id"]
    }
  },
  "firestore": {
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback and bug reports."
    },
    "/utenti_autorizzati/{docId}": {
      "schema": "AuthorizedUser",
      "description": "List of emails authorized to access specific companies."
    },
    "/companies/{azienda_id}": {
      "schema": {
        "title": "Company",
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "adminEmail": { "type": "string" },
          "createdAt": { "type": "object" }
        }
      },
      "description": "Organization details."
    },
    "/workers/{workerId}": {
      "schema": "Worker",
      "description": "Collection of workers accessible by code."
    },
    "/timeEntries/{entryId}": {
      "schema": "TimeEntry",
      "description": "Daily work records."
    },
    "/materialRequests/{requestId}": {
      "schema": "MaterialRequest",
      "description": "Material orders."
    },
    "/clockEvents/{eventId}": {
      "schema": "ClockEvent",
      "description": "Clock in/out events."
    },
    "/admins/{adminId}": {
      "schema": {
        "title": "Admin",
        "type": "object",
        "properties": {}
      },
      "description": "Admin registry for RBAC."
    }
  }
}
